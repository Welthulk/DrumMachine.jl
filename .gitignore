# Kits built locally (older builds landed in kits/; builders now write to the user kit folder).
# Only the shipped BlackPearl kit belongs in the repo.
/kits/*
!/kits/BlackPearl/

# Audio files and JSON compositions are never published.
# Exceptions: the samples of the shipped kit and the test file for the JSON import.
*.wav
*.wav.tmp
*.m4a
*.mp3
*.flac
*.ogg
*.aac
*.mid
*.midi
*.json
!kits/BlackPearl/*.wav
!test/drum_json_example.json
# Julia
*.jl.cov
*.jl.*.cov
*.jl.mem
*.jl.*.mem
lcov.info
/coverage/
/docs/build/
/docs/Manifest.toml
.vscode/

# Sysimage (tools/build_sysimage.jl)
/build/
